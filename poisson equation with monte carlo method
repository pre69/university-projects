Дискретный случай уравнения Пуассона методом Монте-Карло.
u_{i-1,j} + u_{i+1,j} + u_{i,j-1} + u_{i,j+1}- 4 * u_{i,j} = a_{i,j}

где:
- u_{i,j} — неизвестное значение функции в узле сетки с индексами (i,j);
- a_{i,j} — заданная правая часть уравнения;
- ((ih,jh) принадлежат G_0) — внутренние узлы расчётной области;
- ((ih,jh) принадлежат  d(G_0)) — граничные узлы области;
- h — шаг сетки.
Цель: найти приближённые значения u_{i,j} во всех внутренних узлах сетки с помощью случайных блужданий.


import random

def solve_poisson_mc(nx=5, ny=5, n_walks=20000):
    # Создаём двумерную сетку, заполненную нулями
    u = [[0.0 for j in range(ny)] for i in range(nx)]

    # Возможные направления движения частицы
    directions = [
        (-1, 0),  # вверх
        (1, 0),   # вниз
        (0, -1),  # влево
        (0, 1)    # вправо
    ]

    # Перебираем все внутренние узлы сетки
    for i in range(1, nx - 1):
        for j in range(1, ny - 1):
            total_steps = 0
            # Запускаем n_walks случайных блужданий
            for walk in range(n_walks):
                # Начальная позиция частицы
                x, y = i, j
                steps = 0
                # Случайное блуждание до границы
                while True:
                    di, dj = random.choice(directions)# Выбираем случайное направление
                    x += di # Перемещаем частицу
                    y += dj
                    steps += 1 # Увеличиваем количество шагов
                    # Проверяем достижение границы
                    if (x == 0 or x == nx - 1 or
                        y == 0 or y == ny - 1):
                        break

                # Суммируем количество шагов
                total_steps += steps

            # Среднее количество шагов до границы
            avg_steps = total_steps / n_walks

            # Значение решения в текущем узле
            u[i][j] = -avg_steps / 4
    return u


# Запускаем программу
result = solve_poisson_mc(nx=5, ny=5, n_walks=20000)

print("Решение уравнения Пуассона:")
for row in result:
    print(" ".join(f"{value:8.4f}" for value in row))
